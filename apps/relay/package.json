{
  "name": "@cicada/relay",
  "version": "1.0.0",
  "description": "Cicada Relay - 远程 Mac 控制系统中间服务",
  "main": "src/index.ts",
  "packageManager": "pnpm@9.12.2",
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy",
    "deploy:production": "wrangler deploy",
    "build": "pnpm --filter @cicada/shared run build && tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "test:debug": "DEBUG_MODE=true jest --verbose --no-cache",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\" \"*.json\"",
    "type-check": "pnpm --filter @cicada/shared run build && tsc --noEmit",
    "clean": "rm -rf coverage dist",
    "test:integration": "node scripts/debug-integration.js",
    "diagnostic": "node scripts/debug-diagnostic.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahua9527/Cicada.git",
    "directory": "apps/relay"
  },
  "keywords": ["cicada", "remote-control", "cloudflare-workers"],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Ahua9527/Cicada/issues"
  },
  "homepage": "https://github.com/Ahua9527/Cicada/tree/main/apps/relay#readme",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "^5.9.3",
    "wrangler": "4.107.0",
    "ws": "^8.21.0",
    "@types/jest": "^29.5.12",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.11",
    "eslint": "^8.57.0",
    "@eslint/js": "^8.57.1",
    "@typescript-eslint/parser": "^6.21.0",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "prettier": "^3.9.5"
  },
  "dependencies": {
    "@cicada/shared": "workspace:*",
    "@cloudflare/workers-types": "^4.20260702.1"
  }
}
