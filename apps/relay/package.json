{
  "name": "@cicada/relay",
  "version": "1.0.0",
  "description": "Cicada Relay - 远程 Mac 控制系统中间服务",
  "main": "src/index.ts",
  "scripts": {
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler deploy",
    "deploy:production": "wrangler deploy",
    "build": "bun run --cwd ../../packages/shared build && tsc --noEmit",
    "test": "bun test --timeout 10000",
    "test:watch": "bun run test --watch",
    "test:coverage": "rm -rf coverage && bun run test --coverage && bun scripts/check-coverage.mjs 0.7",
    "test:ci": "bun run test:coverage",
    "test:debug": "DEBUG_MODE=true bun run test",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"test/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\" \"*.json\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.md\" \"*.json\"",
    "type-check": "bun run --cwd ../../packages/shared build && tsc --noEmit",
    "clean": "rm -rf coverage dist",
    "debug:integration": "bun scripts/lib/debug-integration.js",
    "diagnostic": "bun scripts/lib/debug-diagnostic.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ahua9527/Cicada.git",
    "directory": "apps/relay"
  },
  "keywords": ["cicada", "remote-control", "cloudflare-workers"],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Ahua9527/Cicada/issues"
  },
  "homepage": "https://github.com/Ahua9527/Cicada/tree/main/apps/relay#readme",
  "devDependencies": {
    "@eslint/js": "^8.57.1",
    "@types/jest": "^29.5.12",
    "@types/node": "^24.13.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "eslint": "^8.57.0",
    "prettier": "^3.9.5",
    "typescript": "^5.9.3",
    "wrangler": "4.107.0",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@cicada/shared": "workspace:*",
    "@cloudflare/workers-types": "^4.20260702.1"
  }
}
