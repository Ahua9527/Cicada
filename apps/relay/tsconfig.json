{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "allowJs": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "jest", "node"],
    "baseUrl": ".",
    "paths": {
      "@cicada/shared": ["../../packages/shared/src"],
      "@cicada/shared/*": ["../../packages/shared/src/*"],
      "@/*": ["src/*"]
    },
    "composite": true
  },
  "include": ["src/**/*", "test/**/*", "../../packages/shared/src/**/*"],
  "exclude": ["dist", "coverage", "../../packages/shared/dist", "../../packages/shared/node_modules"],
  "references": [
    { "path": "../../packages/shared" }
  ]
}
