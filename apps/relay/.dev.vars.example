# Local-only, non-secret Relay settings. Copy to .dev.vars; never commit .dev.vars.
NODE_ENV="development"
LOG_LEVEL="info"
DEBUG_MODE="false"
RATE_LIMIT_ENABLED="true"
ENABLE_CORS="false"
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:5173"

# CICADA_SESSIONS is a Durable Object binding declared in wrangler.toml, not a variable.
