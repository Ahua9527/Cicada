<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  SMAppService 注册用的 SleepHold launchd daemon 静态 plist。
  打包时由 scripts/build.sh 嵌入 Contents/Library/LaunchDaemons/ 并随包签名。

  - BundleProgram 相对 app bundle 根目录（含 Contents/ 前缀），指向包内 helper；
    不再硬编码 /Applications 路径，App 装到哪都能注册。
  - 无 ProgramArguments：daemon 零参数启动，uid/gid/socket 路径由
    SleepHoldServiceOptionsResolver 在运行时按 console 用户推导（静态签名 plist
    无法携带 per-machine 动态值）。
  - 无 StandardOut/ErrPath：per-user 日志路径无法静态表达，daemon 自举后自行
    freopen 到 ~/.cicada/sleephold.{stdout,stderr}.log。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cicada.sleephold</string>
  <key>BundleProgram</key>
  <string>Contents/Helpers/cicada-sleephold</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>Crashed</key>
    <true/>
  </dict>
</dict>
</plist>
